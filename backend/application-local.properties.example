# Copy thành application-local.properties (đã gitignore) hoặc export biến môi trường

# Database
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT (tối thiểu 32 ký tự)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# Gmail SMTP (đăng ký OTP)
MAIL_USERNAME=your@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# VNPay Sandbox — https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay-return

# URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
